      }
    },
    {
      "index": 3,
      "audio_id": "8455_210777_000050_000001",
      "speaker_id": "8455",
      "original_duration_seconds": 5.710083,
      "transcript": "Now, at the close of the twentieth century, could oppression be carried to such a height as this?",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/8455_210777_000050_000001.wav",
        "unified": "data/libritts-embedding-comparison/unified/8455_210777_000050_000001.wav",
