      }
    },
    {
      "index": 15,
      "audio_id": "5105_28240_000031_000000",
      "speaker_id": "5105",
      "original_duration_seconds": 6.030042,
      "transcript": "\"I am not sure,\" said he, \"but what the tour of the Mediterranean will prove to be the tour of the world.\"",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/5105_28240_000031_000000.wav",
        "unified": "data/libritts-embedding-comparison/unified/5105_28240_000031_000000.wav",
