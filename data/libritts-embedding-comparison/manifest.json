    {
      "index": 9,
      "audio_id": "4992_41806_000027_000000",
      "speaker_id": "4992",
      "original_duration_seconds": 7.69,
      "transcript": "The guests naturally had no associations with the Carey Curse, and the Careys themselves were dumb with amazement and despair.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/4992_41806_000027_000000.wav",
        "unified": "data/libritts-embedding-comparison/unified/4992_41806_000027_000000.wav",
