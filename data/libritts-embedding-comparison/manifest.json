      }
    },
    {
      "index": 4,
      "audio_id": "5142_36377_000016_000001",
      "speaker_id": "5142",
      "original_duration_seconds": 7.05,
      "transcript": "He looked up at Naomi doubtingly from his plate, and looked down again slowly with a frown. When I addressed him, he answered constrainedly.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/5142_36377_000016_000001.wav",
        "unified": "data/libritts-embedding-comparison/unified/5142_36377_000016_000001.wav",
        "transcript": "data/libritts-embedding-comparison/transcripts/5142_36377_000016_000001.normalized.txt",
        "original_audio_source": "data-tts/LibriTTS/test-clean/5142/36377/5142_36377_000016_000001.wav"
      }
    },
    {
      "index": 5,
      "audio_id": "8555_284449_000028_000001",
      "speaker_id": "8555",
      "original_duration_seconds": 5.47,
      "transcript": "Then she gave Rosalie back her magic ring, thanking the kind Witch for all she had done for them.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/8555_284449_000028_000001.wav",
        "unified": "data/libritts-embedding-comparison/unified/8555_284449_000028_000001.wav",
