      "audio_id": "6829_68769_000098_000000",
      "speaker_id": "6829",
      "original_duration_seconds": 6.030042,
      "transcript": "\"Of all the easy marks I ever encountered,\" muttered mr Marshall, \"this young Forbes is the easiest.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/6829_68769_000098_000000.wav",
        "unified": "data/libritts-embedding-comparison/unified/6829_68769_000098_000000.wav",
