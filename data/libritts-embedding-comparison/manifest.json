      }
    },
    {
      "index": 8,
      "audio_id": "1188_133604_000012_000003",
      "speaker_id": "1188",
      "original_duration_seconds": 9.76,
      "transcript": "Some of the touches, indeed, when the tint has been mixed with much water, have been laid in little drops or ponds, so that the pigment might crystallize hard at the edge.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/1188_133604_000012_000003.wav",
        "unified": "data/libritts-embedding-comparison/unified/1188_133604_000012_000003.wav",
