    {
      "index": 2,
      "audio_id": "3729_6852_000003_000001",
      "speaker_id": "3729",
      "original_duration_seconds": 7.72,
      "transcript": "Baletti's father, who had just recovered from a long illness, was not with us, but we had his father's sister, who was older than Mario.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/3729_6852_000003_000001.wav",
        "unified": "data/libritts-embedding-comparison/unified/3729_6852_000003_000001.wav",
