      }
    },
    {
      "index": 7,
      "audio_id": "1284_1181_000013_000000",
      "speaker_id": "1284",
      "original_duration_seconds": 8.74,
      "transcript": "\"He means,\" explained Ojo, \"that unless your servant has good brains she won't know how to obey you properly, nor do the things you ask her to do.\"",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/1284_1181_000013_000000.wav",
        "unified": "data/libritts-embedding-comparison/unified/1284_1181_000013_000000.wav",
