      "audio_id": "7176_92135_000070_000002",
      "speaker_id": "7176",
      "original_duration_seconds": 5.480042,
      "transcript": "Let your actors have tea by all means, but see that it is a properly histrionic tea.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/7176_92135_000070_000002.wav",
