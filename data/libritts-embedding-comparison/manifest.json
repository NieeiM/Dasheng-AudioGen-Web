      "audio_id": "5683_32879_000029_000003",
      "speaker_id": "5683",
      "original_duration_seconds": 6.52,
      "transcript": "If he does not return in a day or two, Chelford, I am sure, will speak to me, and then I shall tell him my resolution.'",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/5683_32879_000029_000003.wav",
        "unified": "data/libritts-embedding-comparison/unified/5683_32879_000029_000003.wav",
