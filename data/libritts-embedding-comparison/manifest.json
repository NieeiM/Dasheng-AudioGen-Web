      "index": 13,
      "audio_id": "1089_134691_000045_000005",
      "speaker_id": "1089",
      "original_duration_seconds": 7.289917,
      "transcript": "Her bosom was as a bird's, soft and slight, slight and soft as the breast of some dark plumaged dove.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/1089_134691_000045_000005.wav",
        "unified": "data/libritts-embedding-comparison/unified/1089_134691_000045_000005.wav",
