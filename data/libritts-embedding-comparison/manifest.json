      }
    },
    {
      "index": 6,
      "audio_id": "8224_274384_000017_000001",
      "speaker_id": "8224",
      "original_duration_seconds": 7.04,
      "transcript": "They were such as a captive, entirely at mercy, could expect from the most inexorable victor.",
      "files": {
        "acoustic": "data/libritts-embedding-comparison/acoustic/8224_274384_000017_000001.wav",
        "unified": "data/libritts-embedding-comparison/unified/8224_274384_000017_000001.wav",
